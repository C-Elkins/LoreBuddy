#!/bin/sh

set -eu

case "${1:-}" in
    validate)
        shift
        exec "$(dirname "$0")/validate_lore_data.py" "$@"
        ;;
    author)
        shift
        exec python3 "$(dirname "$0")/lorebuddy_author.py" "$@"
        ;;
    research)
        shift
        exec python3 "$(dirname "$0")/lorebuddy_research.py" "$@"
        ;;
    explore)
        shift
        exec python3 "$(dirname "$0")/lorebuddy_explorer.py" "$@"
        ;;
    *)
        printf '%s\n' "Usage: tools/lorebuddy validate|author|research|explore [dataset]" >&2
        exit 2
        ;;
esac
