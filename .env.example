# Copy to .env.local and fill in locally. Never commit real credentials.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Confirm the correct values in the current WoW Classic API reference.
BLIZZARD_REGION=us
BLIZZARD_NAMESPACE=dynamic-us
BLIZZARD_LOCALE=en_US

# Example endpoint; override this for the WoW Classic/TBC resource you need.
BLIZZARD_API_PATH=/data/wow/token/index