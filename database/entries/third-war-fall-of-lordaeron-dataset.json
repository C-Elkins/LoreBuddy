  "statements": [
    {
      "id": "arthas_menethil_quick",
      "entityId": "arthas_menethil",
      "detailLevel": "quick",
      "text": "Arthas Menethil was the Crown Prince of Lordaeron before his fall to corruption.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "arthas_menethil_story",
      "entityId": "arthas_menethil",
      "detailLevel": "story",
      "text": "Seeking to stop a plague spreading through his kingdom, Arthas took increasingly extreme measures, ultimately claiming the runeblade Frostmourne and turning against his own people.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "context"
    },
    {
      "id": "arthas_menethil_deep",
      "entityId": "arthas_menethil",
      "detailLevel": "deep",
      "text": "Arthas's actions culminated in the fall of Lordaeron's capital and his eventual fusion with the Lich King, sealing his transformation into an even greater threat.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "discoveryGateIds": ["gate_fall_of_lordaeron_witnessed"],
      "spoilerLevel": "major_reveal"
    },
    {
      "id": "jaina_proudmoore_quick",
      "entityId": "jaina_proudmoore",
      "detailLevel": "quick",
      "text": "Jaina Proudmoore is a human sorceress who was once one of Arthas's closest companions.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "jaina_proudmoore_story",
      "entityId": "jaina_proudmoore",
      "detailLevel": "story",
      "text": "Jaina tried to warn others of Arthas's growing recklessness during the Third War, and led survivors away from Lordaeron to found a new home on Kalimdor.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "context"
    },
    {
      "id": "uther_quick",
      "entityId": "uther",
      "detailLevel": "quick",
      "text": "Uther the Lightbringer was a paladin of the Silver Hand and Arthas's mentor.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "uther_story",
      "entityId": "uther",
      "detailLevel": "story",
      "text": "Uther refused to follow Arthas's increasingly ruthless orders, and was ultimately killed by his own former student.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "reveal"
    },
    {
      "id": "kelthuzad_quick",
      "entityId": "kelthuzad",
      "detailLevel": "quick",
      "text": "Kel'Thuzad is a human archmage who founded the Cult of the Damned in service to the Lich King.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "kelthuzad_story",
      "entityId": "kelthuzad",
      "detailLevel": "story",
      "text": "Kel'Thuzad abandoned the Kirin Tor to spread the plague of undeath, helping pave the way for the Scourge's invasion of Lordaeron.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "context"
    },
    {
      "id": "sylvanas_windrunner_quick",
      "entityId": "sylvanas_windrunner",
      "detailLevel": "quick",
      "text": "Sylvanas Windrunner is the former Ranger-General of Silvermoon who now leads the Forsaken.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "sylvanas_windrunner_story",
      "entityId": "sylvanas_windrunner",
      "detailLevel": "story",
      "text": "Slain defending her homeland and raised as a banshee by the Scourge, Sylvanas eventually broke free of the Lich King's control and rallied other free undead into the Forsaken.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "reveal"
    },
    {
      "id": "the_scourge_quick",
      "entityId": "the_scourge",
      "detailLevel": "quick",
      "text": "The Scourge is the undead army raised by the Lich King to conquer Lordaeron.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "the_scourge_story",
      "entityId": "the_scourge",
      "detailLevel": "story",
      "text": "Spread through a magical plague, the Scourge swept across Lordaeron during the Third War, turning the living into undead servants of the Lich King.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "context"
    },
    {
      "id": "the_forsaken_quick",
      "entityId": "the_forsaken",
      "detailLevel": "quick",
      "text": "The Forsaken are undead who broke free of the Lich King's control under Sylvanas Windrunner.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "the_forsaken_story",
      "entityId": "the_forsaken",
      "detailLevel": "story",
      "text": "United by their reclaimed free will, the Forsaken carved out a home in the ruins of Lordaeron and later allied themselves with the Horde.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "context"
    },
    {
      "id": "lordaeron_quick",
      "entityId": "lordaeron",
      "detailLevel": "quick",
      "text": "Lordaeron was the human kingdom whose capital fell during the Scourge invasion.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "lordaeron_story",
      "entityId": "lordaeron",
      "detailLevel": "story",
      "text": "Once the seat of the Alliance of Lordaeron, the kingdom's capital ultimately fell to the Scourge and later became the ruined home of the Forsaken.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "reveal"
    },
    {
      "id": "third_war_quick",
      "entityId": "third_war",
      "detailLevel": "quick",
      "text": "The Third War was the Scourge invasion of Lordaeron and the wider conflict that followed.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "safe"
    },
    {
      "id": "third_war_story",
      "entityId": "third_war",
      "detailLevel": "story",
      "text": "The Third War reshaped Azeroth's factions: the Scourge devastated Lordaeron, the orcs founded a new Horde on Kalimdor, and Illidan and the night elves clashed with the Burning Legion.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "context"
    },
    {
      "id": "fall_of_lordaeron_quick",
      "entityId": "fall_of_lordaeron",
      "detailLevel": "quick",
      "text": "The Fall of Lordaeron was the destruction of the kingdom's capital at Arthas's hand.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors"],
      "spoilerLevel": "reveal"
    },
    {
      "id": "fall_of_lordaeron_story",
      "entityId": "fall_of_lordaeron",
      "detailLevel": "story",
      "text": "Arthas's return to Lordaeron, corrupted and wielding Frostmourne, marked the definitive end of the kingdom his family once ruled.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_third_war_contributors", "src_warcraft_wiki_third_war"],
      "spoilerLevel": "major_reveal"
    }
