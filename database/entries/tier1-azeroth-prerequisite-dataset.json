  "statements": [
    {
      "id": "dark_portal_quick",
      "entityId": "dark_portal",
      "detailLevel": "quick",
      "text": "The Dark Portal is a massive stone ring linking Azeroth to Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "dark_portal_story",
      "entityId": "dark_portal",
      "detailLevel": "story",
      "text": "First opened by Medivh to allow the orcs onto Azeroth, the portal was later destroyed and lay dormant for years before Cho'gall reopened it just before the Burning Crusade.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "dark_portal_deep",
      "entityId": "dark_portal",
      "detailLevel": "deep",
      "text": "The Alliance built Nethergarde Keep nearby to keep watch over the ruined portal, never expecting it would one day reopen on its own.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "medivh_quick",
      "entityId": "medivh",
      "detailLevel": "quick",
      "text": "Medivh was the last Guardian of Tirisfal before opening the original Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "medivh_story",
      "entityId": "medivh",
      "detailLevel": "story",
      "text": "Secretly corrupted by the Burning Legion, Medivh opened the Dark Portal to Draenor, allowing the orc clans to invade Azeroth in the First War.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "medivh_deep",
      "entityId": "medivh",
      "detailLevel": "deep",
      "text": "How much of Medivh's own will remained during his corruption is still debated; some accounts treat him as culpable, others as a tragic vessel for Sargeras's influence.",
      "canonStatus": "disputed",
      "epistemicStatus": "interpretation",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "khadgar_quick",
      "entityId": "khadgar",
      "detailLevel": "quick",
      "text": "Khadgar was Medivh's apprentice and later a leading Alliance mage.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "khadgar_story",
      "entityId": "khadgar",
      "detailLevel": "story",
      "text": "Khadgar helped uncover Medivh's corruption during the First War and, years later, became a key figure guiding adventurers through the reopened Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "draenor_quick",
      "entityId": "draenor",
      "detailLevel": "quick",
      "text": "Draenor was the orc homeworld beyond the Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "draenor_story",
      "entityId": "draenor",
      "detailLevel": "story",
      "text": "Draenor was later shattered into the fragmented realm now known as Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "the_horde_quick",
      "entityId": "the_horde",
      "detailLevel": "quick",
      "text": "The Horde began as the orc clans who invaded Azeroth through the Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "the_horde_story",
      "entityId": "the_horde",
      "detailLevel": "story",
      "text": "After years of internment following the First and Second Wars, Thrall freed the orcs and reformed the Horde on Kalimdor.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "the_alliance_quick",
      "entityId": "the_alliance",
      "detailLevel": "quick",
      "text": "The Alliance is a coalition formed to oppose the orcish invasions of Azeroth.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "the_alliance_story",
      "entityId": "the_alliance",
      "detailLevel": "story",
      "text": "Formed from humans, dwarves, night elves, gnomes, and other races, the Alliance has remained an uneasy rival of the Horde since the First War.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "thrall_quick",
      "entityId": "thrall",
      "detailLevel": "quick",
      "text": "Thrall is the Warchief who reformed the Horde after freeing the orcs from internment.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "thrall_story",
      "entityId": "thrall",
      "detailLevel": "story",
      "text": "Raised in captivity, Thrall escaped and rallied the orc clans to found a new Horde built on honor rather than demonic corruption.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "cho_gall_quick",
      "entityId": "cho_gall",
      "detailLevel": "quick",
      "text": "Cho'gall is a Twilight's Hammer cult leader who reopened the Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "cho_gall_story",
      "entityId": "cho_gall",
      "detailLevel": "story",
      "text": "Shortly before the Burning Crusade, Cho'gall used a powerful relic to reopen the long-dormant Dark Portal, drawing adventurers' attention to Outland once more.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_wowhead_classic_lore"]
    },
    {
      "id": "first_war_quick",
      "entityId": "first_war",
      "detailLevel": "quick",
      "text": "The First War was the initial orcish invasion of Azeroth through the Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "first_war_story",
      "entityId": "first_war",
      "detailLevel": "story",
      "text": "The orc clans, empowered by fel magic, overwhelmed the kingdom of Azeroth, beginning generations of conflict between orcs and humans.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "first_war_deep",
      "entityId": "first_war",
      "detailLevel": "deep",
      "text": "Both Medivh and a young Khadgar played pivotal, if very different, roles in how the First War began and was ultimately exposed.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_warcraft_wiki_classic_lore"]
    },
    {
      "id": "blasted_lands_quick",
      "entityId": "blasted_lands",
      "detailLevel": "quick",
      "text": "The Blasted Lands are a scarred region of Azeroth surrounding the Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "blasted_lands_story",
      "entityId": "blasted_lands",
      "detailLevel": "story",
      "text": "The land here was twisted by the portal's destruction, and the Alliance built Nethergarde Keep nearby to keep watch over the ruins.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_wowhead_classic_lore"]
    },
    {
      "id": "nethergarde_keep_quick",
      "entityId": "nethergarde_keep",
      "detailLevel": "quick",
      "text": "Nethergarde Keep is an Alliance fortress watching over the Dark Portal.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "nethergarde_keep_story",
      "entityId": "nethergarde_keep",
      "detailLevel": "story",
      "text": "Built in the Blasted Lands, the keep gave the Alliance a forward base to monitor the ruined portal for any sign of renewed activity.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_wowhead_classic_lore"]
    },
    {
      "id": "opening_of_the_dark_portal_quick",
      "entityId": "opening_of_the_dark_portal",
      "detailLevel": "quick",
      "text": "The Opening of the Dark Portal was the world event that reactivated the portal just before the Burning Crusade.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors"]
    },
    {
      "id": "opening_of_the_dark_portal_story",
      "entityId": "opening_of_the_dark_portal",
      "detailLevel": "story",
      "text": "Cho'gall's ritual reopened the portal, drawing invasion forces onto Azeroth and giving adventurers their first path into Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_tier1_contributors", "src_wowhead_classic_lore"]
    }
  ],
