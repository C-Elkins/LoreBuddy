  "statements": [
    {
      "id": "illidan_stormrage_quick",
      "entityId": "illidan_stormrage",
      "detailLevel": "quick",
      "text": "Illidan Stormrage is a night elf turned demon, twin brother of Malfurion, and the first demon hunter.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "illidan_stormrage_story",
      "entityId": "illidan_stormrage",
      "detailLevel": "story",
      "text": "Once imprisoned for ten thousand years for creating a second Well of Eternity, Illidan was freed to fight the Burning Legion. He later fled to Outland, built an army of demon hunters, and ruled from the Black Temple.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "illidan_stormrage_deep",
      "entityId": "illidan_stormrage",
      "detailLevel": "deep",
      "text": "Adventurers, aided by Akama and Illidan's old jailer Maiev Shadowsong, stormed the Black Temple and ended his rule over Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"],
      "discoveryGateIds": ["gate_black_temple_defeated"]
    },
    {
      "id": "malfurion_stormrage_quick",
      "entityId": "malfurion_stormrage",
      "detailLevel": "quick",
      "text": "Malfurion Stormrage is Illidan's twin brother and the first druid of the night elves.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "malfurion_stormrage_story",
      "entityId": "malfurion_stormrage",
      "detailLevel": "story",
      "text": "Malfurion opposed his brother's methods throughout the War of the Ancients and its aftermath, eventually banishing Illidan after his transformation into a demon.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "malfurion_stormrage_deep",
      "entityId": "malfurion_stormrage",
      "detailLevel": "deep",
      "text": "Despite their long rivalry, Malfurion's disputes with Illidan were rooted in differing views on how to face the Burning Legion rather than simple animosity.",
      "canonStatus": "unknown",
      "epistemicStatus": "interpretation",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "tyrande_whisperwind_quick",
      "entityId": "tyrande_whisperwind",
      "detailLevel": "quick",
      "text": "Tyrande Whisperwind is the High Priestess of Elune and a childhood friend of both Stormrage brothers.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "tyrande_whisperwind_story",
      "entityId": "tyrande_whisperwind",
      "detailLevel": "story",
      "text": "Tyrande freed Illidan from his ten-thousand-year imprisonment to help fight the Burning Legion during the Third War, a decision that strained her bond with Malfurion.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "maiev_shadowsong_quick",
      "entityId": "maiev_shadowsong",
      "detailLevel": "quick",
      "text": "Maiev Shadowsong is a Warden of the night elves who imprisoned Illidan for millennia.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "maiev_shadowsong_story",
      "entityId": "maiev_shadowsong",
      "detailLevel": "story",
      "text": "After Illidan's release, Maiev pursued him relentlessly across Kalimdor and Outland, determined to see him imprisoned again.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "maiev_shadowsong_deep",
      "entityId": "maiev_shadowsong",
      "detailLevel": "deep",
      "text": "Maiev's role in confronting Illidan at the Black Temple closed out a pursuit that had defined much of her life.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"],
      "discoveryGateIds": ["gate_black_temple_defeated"]
    },
    {
      "id": "akama_quick",
      "entityId": "akama",
      "detailLevel": "quick",
      "text": "Akama is a broken draenei leader who once served Illidan in Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "akama_story",
      "entityId": "akama",
      "detailLevel": "story",
      "text": "Akama's people were indebted to Illidan for defending them from the fel orcs, but Akama grew disillusioned with Illidan's rule over the Black Temple.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "kaelthas_sunstrider_quick",
      "entityId": "kaelthas_sunstrider",
      "detailLevel": "quick",
      "text": "Kael'thas Sunstrider is a blood elf prince who allied his people with Illidan in Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "kaelthas_sunstrider_story",
      "entityId": "kaelthas_sunstrider",
      "detailLevel": "story",
      "text": "Seeking a cure for the blood elves' magic addiction, Kael'thas pledged his people's allegiance to Illidan, though the alliance did not last.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "lady_vashj_quick",
      "entityId": "lady_vashj",
      "detailLevel": "quick",
      "text": "Lady Vashj is a naga sorceress and one of Illidan's most loyal lieutenants.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "lady_vashj_story",
      "entityId": "lady_vashj",
      "detailLevel": "story",
      "text": "Vashj commanded Illidan's naga forces in Outland, securing water and resources for his stronghold at the Black Temple.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "guldan_quick",
      "entityId": "guldan",
      "detailLevel": "quick",
      "text": "Gul'dan is an orc warlock whose skull became a source of demonic power long after his death.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "guldan_story",
      "entityId": "guldan",
      "detailLevel": "story",
      "text": "The Skull of Gul'dan, discovered years after the warlock's death, held fel energy that would later transform Illidan into a demon.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "black_temple_quick",
      "entityId": "black_temple",
      "detailLevel": "quick",
      "text": "The Black Temple is a former draenei temple in Shadowmoon Valley that Illidan claimed as his stronghold.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "black_temple_story",
      "entityId": "black_temple",
      "detailLevel": "story",
      "text": "Originally known as the Temple of Karabor, the site became the seat of Illidan's rule over Outland until adventurers and his former allies brought about his defeat there.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_wowhead_black_temple"]
    },
    {
      "id": "black_temple_deep",
      "entityId": "black_temple",
      "detailLevel": "deep",
      "text": "The fall of the Black Temple marked the end of Illidan's control over Outland and the beginning of Akama's efforts to restore the temple.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_wowhead_black_temple"],
      "discoveryGateIds": ["gate_black_temple_defeated"]
    },
    {
      "id": "outland_quick",
      "entityId": "outland",
      "detailLevel": "quick",
      "text": "Outland is the shattered remains of the orc homeworld Draenor.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "outland_story",
      "entityId": "outland",
      "detailLevel": "story",
      "text": "After the Dark Portal reopened, Outland became the stage for Illidan's exile, his rule from the Black Temple, and the arrival of adventurers from Azeroth.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_wowhead_black_temple"]
    },
    {
      "id": "skull_of_guldan_quick",
      "entityId": "skull_of_guldan",
      "detailLevel": "quick",
      "text": "The Skull of Gul'dan is a demonic artifact tied to the orc warlock's fel magic.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "skull_of_guldan_story",
      "entityId": "skull_of_guldan",
      "detailLevel": "story",
      "text": "When Illidan absorbed the skull's fel energy during the Third War, he transformed into a demon in order to defeat the dreadlord Tichondrius.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "the_illidari_quick",
      "entityId": "the_illidari",
      "detailLevel": "quick",
      "text": "The Illidari are demon hunters trained by Illidan to fight the Burning Legion using its own methods.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "the_illidari_story",
      "entityId": "the_illidari",
      "detailLevel": "story",
      "text": "Formed from Illidan's most devoted followers, the Illidari embraced fel powers similar to their master's in order to combat demons on equal footing.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "war_of_the_ancients_quick",
      "entityId": "war_of_the_ancients",
      "detailLevel": "quick",
      "text": "The War of the Ancients was an ancient war against the Burning Legion fought at the Well of Eternity.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "war_of_the_ancients_story",
      "entityId": "war_of_the_ancients",
      "detailLevel": "story",
      "text": "During the war, Illidan's choices set him at odds with his brother Malfurion, a rift that would echo for ten thousand years.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_warcraft_wiki_illidan"]
    },
    {
      "id": "fall_of_the_black_temple_quick",
      "entityId": "fall_of_the_black_temple",
      "detailLevel": "quick",
      "text": "The Fall of the Black Temple refers to the battle in which Illidan's rule over Outland was ended.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "fall_of_the_black_temple_story",
      "entityId": "fall_of_the_black_temple",
      "detailLevel": "story",
      "text": "Adventurers from the Alliance and Horde, working alongside Akama and Maiev Shadowsong, breached the Black Temple and confronted Illidan directly.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_wowhead_black_temple"]
    },
    {
      "id": "fall_of_the_black_temple_deep",
      "entityId": "fall_of_the_black_temple",
      "detailLevel": "deep",
      "text": "Illidan's defeat at the Black Temple allowed Akama to reclaim the temple and marked a turning point in the fight against the Burning Legion's influence over Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_wowhead_black_temple"],
      "discoveryGateIds": ["gate_black_temple_defeated"]
    },
    {
      "id": "hellfire_peninsula_quick",
      "entityId": "hellfire_peninsula",
      "detailLevel": "quick",
      "text": "Hellfire Peninsula is the scarred zone surrounding the Dark Portal in Outland.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors"]
    },
    {
      "id": "hellfire_peninsula_story",
      "entityId": "hellfire_peninsula",
      "detailLevel": "story",
      "text": "As the first zone most adventurers reach after passing through the Dark Portal, Hellfire Peninsula introduces the fel-corrupted state of Outland under the influence of the Burning Legion and Illidan's forces.",
      "canonStatus": "confirmed",
      "epistemicStatus": "fact",
      "sourceIds": ["src_lorebuddy_contributors", "src_wowhead_black_temple"]
    }
  ],
