{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorebuddy.dev/schema/lore-statement.schema.json",
  "title": "LoreBuddy Lore Statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityId", "detailLevel", "text", "canonStatus", "epistemicStatus", "sourceIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "entityId": { "type": "string" },
    "detailLevel": { "type": "string", "enum": ["quick", "story", "deep"] },
    "text": { "type": "string", "minLength": 1 },
    "canonStatus": { "type": "string", "enum": ["confirmed", "disputed", "non_canon", "unknown"] },
    "epistemicStatus": { "type": "string", "enum": ["fact", "interpretation", "theory", "speculation"] },
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "discoveryGateIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}