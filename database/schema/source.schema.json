{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorebuddy.dev/schema/source.schema.json",
  "title": "LoreBuddy Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "publisher", "title", "kind", "classification", "reference", "attribution", "license", "verificationStatus"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "publisher": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["blizzard_api", "quest_text", "npc_dialogue", "book", "external_reference", "community_contribution"] },
    "classification": { "type": "string", "enum": ["primary", "secondary", "community", "speculation"] },
    "reference": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "namespace": { "type": "string" },
    "region": { "type": "string" },
    "locale": { "type": "string" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "attribution": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "verificationStatus": { "type": "string", "enum": ["unverified", "reviewed", "verified"] }
  }
}