{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorebuddy.dev/schema/player-discovery-state.schema.json",
  "title": "LoreBuddy Player Discovery State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "discoveredGateIds", "seenStatementIds", "dismissedHintIds"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "discoveredGateIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "seenStatementIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dismissedHintIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredCharacters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredLocations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredEvents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredFactions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredDungeons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredRaids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredBooks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "discoveredItems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "completedQuestChainIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "seenLore": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "spoilerPreference": {
      "type": "string",
      "enum": ["no_spoilers", "context_only", "moderate", "full_lore", "show_everything"],
      "default": "moderate"
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}